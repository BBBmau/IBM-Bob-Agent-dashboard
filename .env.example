# Firebase web app configuration. These values identify the Firebase project
# and are safe for browser use; authorization belongs in Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Use "(default)" or a named Firestore database such as "list-resources".
VITE_FIREBASE_DATABASE_ID=list-resources

# Explicit local preview mode. Never enable this in a production deployment.
VITE_DEMO_MODE=false

# Optional emulator endpoints.
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
